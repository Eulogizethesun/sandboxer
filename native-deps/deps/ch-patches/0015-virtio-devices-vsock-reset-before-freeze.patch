+/// Result of a device transport reset published by the host.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct TransportResetResult {
+    /// A transport reset event was published to the guest.
+    pub published: bool,
+    /// The guest consumed the event and refilled the event queue.
+    pub acked: bool,
+}
+
+/// State shared between the device (VMM thread) and its worker thread for a
+/// transport reset published while the VM is running.
+///
+/// None of this is serialized: it only describes a reset that was asked for in
+/// the current activation, exactly like `reset_published`.
+#[derive(Default)]
+pub struct TransportResetShared {
+    /// A command was written and the worker has not processed it yet.
+    pub(crate) outstanding: AtomicBool,
+    /// The worker finished processing the current command.
+    pub(crate) completed: AtomicBool,
+    /// Result of the current command, as reported to the API caller.
+    pub(crate) published: AtomicBool,
+    /// The guest acknowledged the published reset.
+    pub(crate) acked: AtomicBool,
+    /// Guest event queue avail index observed right before publishing. The
+    /// guest acknowledges by advancing it, so a kick alone is not enough.
+    pub(crate) expected_avail: AtomicU32,
+    /// A kick with an advanced avail index was observed but the test
+    /// `delay-ack` hook asked to defer the acknowledgement.
+    pub(crate) ack_ready: AtomicBool,
+    /// The test `delay-ack` hook already deferred one acknowledgement.
+    pub(crate) ack_deferred: AtomicBool,
+}
+
+impl TransportResetShared {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self::default())
+    }
+}
+
+/// Handle returned by [`VirtioDevice::reset_transport`].
+///
+/// It only carries shared atomic state so the caller can release the device
+/// lock before waiting for the guest acknowledgement.
+pub struct TransportResetHandle {
+    shared: Arc<TransportResetShared>,
+    started: Instant,
+}
+
+impl TransportResetHandle {
+    /// Handle for a device that did not publish anything.
+    pub fn not_published() -> Self {
+        let shared = TransportResetShared::new();
+        shared.completed.store(true, Ordering::Release);
+        Self {
+            shared,
+            started: Instant::now(),
+        }
+    }
+
+    /// Handle for a reset that was already published by an earlier request.
+    pub fn already_published(shared: Arc<TransportResetShared>) -> Self {
+        shared.completed.store(true, Ordering::Release);
+        shared.published.store(true, Ordering::Release);
+        Self {
+            shared,
+            started: Instant::now(),
+        }
+    }
+
+    pub fn new(shared: Arc<TransportResetShared>) -> Self {
+        Self {
+            shared,
+            started: Instant::now(),
+        }
+    }
+
+    /// Wait up to `timeout` for the worker to publish and for the guest to
+    /// acknowledge. Returns as soon as both outcomes are known.
+    pub fn wait(&self, timeout: Duration) -> TransportResetResult {
+        let deadline = self.started + timeout;
+
+        loop {
+            if self.shared.completed.load(Ordering::Acquire) {
+                break;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                warn!("transport reset: worker did not process the request before timeout");
+                return TransportResetResult::default();
+            }
+            thread::sleep((deadline - now).min(Duration::from_millis(1)));
+        }
+
+        if !self.shared.published.load(Ordering::Acquire) {
+            return TransportResetResult::default();
+        }
+
+        loop {
+            if self.shared.acked.load(Ordering::Acquire) {
+                return TransportResetResult {
+                    published: true,
+                    acked: true,
+                };
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return TransportResetResult {
+                    published: true,
+                    acked: false,
+                };
+            }
+            thread::sleep((deadline - now).min(Duration::from_millis(1)));
+        }
+    }
+}
