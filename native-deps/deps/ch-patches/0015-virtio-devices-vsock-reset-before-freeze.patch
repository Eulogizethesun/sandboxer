+/// Failure-injection knobs for the transport reset path. They are only parsed
+/// when `KUASAR_TEST_HOOKS=1`, so a production binary ignores them entirely.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct VsockResetHooks {
+    /// Defer the first acknowledgement so a snapshot falls back to the gate.
+    pub delay_ack: bool,
+    /// Never acknowledge; the guest looks unresponsive.
+    pub drop_ack: bool,
+    /// Pretend the guest has no event descriptor available.
+    pub no_desc: bool,
+    /// Publish the event but report a failed publish to the API caller.
+    pub fail_after_publish: bool,
+    /// Inject a kick without an avail index advance after publishing.
+    pub stale_kick: bool,
+}
+
+impl VsockResetHooks {
+    fn from_env() -> Self {
+        // Release binaries ignore the test hooks completely, even when the
+        // environment variables are present. A test build can opt in through
+        // the `kuasar-test-hooks` feature.
+        if !cfg!(any(debug_assertions, feature = "kuasar-test-hooks")) {
+            return Self::default();
+        }
+
+        if env::var("KUASAR_TEST_HOOKS").ok().as_deref() != Some("1") {
+            return Self::default();
+        }
+
+        let Ok(spec) = env::var("KUASAR_VSOCK_RESET_HOOKS") else {
+            return Self::default();
+        };
+
+        let mut hooks = Self::default();
+        for hook in spec.split(',').map(str::trim).filter(|h| !h.is_empty()) {
+            match hook {
+                "delay-ack" => hooks.delay_ack = true,
+                "drop-ack" => hooks.drop_ack = true,
+                "no-desc" => hooks.no_desc = true,
+                "fail-after-publish" => hooks.fail_after_publish = true,
+                "stale-kick" => hooks.stale_kick = true,
+                other => warn!("vsock: ignoring unknown KUASAR_VSOCK_RESET_HOOKS value {other:?}"),
+            }
+        }
+
+        if hooks.delay_ack || hooks.drop_ack || hooks.no_desc
+            || hooks.fail_after_publish || hooks.stale_kick
+        {
+            info!("vsock: KUASAR transport reset test hooks enabled: {hooks:?}");
+        }
+
+        hooks
+    }
+}
 
