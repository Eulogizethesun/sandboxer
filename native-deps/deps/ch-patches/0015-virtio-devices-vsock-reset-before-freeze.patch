+    /// Drop event queue notifications that predate a transport reset. A kick
+    /// only advertises descriptors already visible through the avail ring, so
+    /// it cannot acknowledge a reset that has not been published yet.
+    fn drain_evt_kicks(&self) {
+        loop {
+            match self.queue_evts[EVT_QUEUE_INDEX].read() {
+                Ok(_) => {}
+                Err(err) if err.kind() == io::ErrorKind::WouldBlock => break,
+                Err(err) => {
+                    warn!("vsock: failed to drain event queue kick: {err:?}");
+                    break;
+                }
+            }
+        }
+    }
+
+    fn report_publish_failure(&self, shared: &TransportResetShared, reason: &str) {
+        shared.published.store(false, Ordering::Release);
+        shared.completed.store(true, Ordering::Release);
+        warn!("vsock: transport reset not published ({reason})");
+    }
+
+    /// Publish VIRTIO_VSOCK_EVENT_TRANSPORT_RESET from the worker using its
+    /// live queues. Returns whether the event was published.
+    ///
+    /// This runs while the VM is running, which is why the config space and
+    /// the used ring are updated from the worker instead of the VMM thread.
+    fn publish_transport_reset(&mut self) -> bool {
+        let Some(shared) = self.reset_shared.clone() else {
+            return false;
+        };
+
+        shared.outstanding.store(false, Ordering::Release);
+
+        // Idempotency: the device already published a reset since the last
+        // activate/resume/reset. Report the current acknowledgement state
+        // instead of injecting a second event.
+        if self.reset_published.load(Ordering::Acquire) {
+            info!("vsock: transport reset already published, not publishing again (running reset)");
+            shared.published.store(true, Ordering::Release);
+            shared.completed.store(true, Ordering::Release);
+            return true;
+        }
+
+        // A pending reset means an event is already sitting in the used ring
+        // (restored device, or an acknowledgement that has not arrived yet).
+        // Publishing again would double the event.
+        if self.transport_reset_pending.load(Ordering::Acquire) {
+            info!("vsock: transport reset already pending, not publishing again (running reset)");
+            self.reset_published.store(true, Ordering::Release);
+            shared.published.store(true, Ordering::Release);
+            shared.completed.store(true, Ordering::Release);
+            return true;
+        }
+
+        self.drain_evt_kicks();
+
+        if self.reset_hooks.no_desc {
+            self.report_publish_failure(&shared, "no descriptor (test hook)");
+            return false;
+        }
+
+        let Some(event_queue) = self.event_queue.clone() else {
+            self.report_publish_failure(&shared, "no shared event queue");
+            return false;
+        };
+        let mut queue = event_queue.lock().unwrap();
+
+        let baseline = match queue.avail_idx(self.mem.memory().deref(), Ordering::Acquire) {
+            Ok(idx) => idx.0,
+            Err(err) => {
+                self.report_publish_failure(&shared, &format!("cannot read avail index: {err:?}"));
+                return false;
+            }
+        };
+
+        let Some(mut desc_chain) = queue.pop_descriptor_chain(self.mem.memory()) else {
+            self.report_publish_failure(&shared, "event queue has no available descriptor");
+            return false;
+        };
+
+        let Some(desc) = desc_chain.next() else {
+            queue.go_to_previous_position();
+            self.report_publish_failure(&shared, "event descriptor chain is empty");
+            return false;
+        };
+
+        if !desc.is_write_only() || desc.len() < size_of::<u32>() as u32 {
+            let write_only = desc.is_write_only();
+            let len = desc.len();
+            queue.go_to_previous_position();
+            self.report_publish_failure(
+                &shared,
+                &format!("invalid event descriptor: write_only={write_only}, len={len}"),
+            );
+            return false;
+        }
+
+        let addr = desc
+            .addr()
+            .translate_gva(self.access_platform.as_deref(), size_of::<u32>());
+        if let Err(err) = desc_chain
+            .memory()
+            .write_obj(VIRTIO_VSOCK_EVENT_TRANSPORT_RESET.to_le(), addr)
+        {
+            queue.go_to_previous_position();
+            self.report_publish_failure(
+                &shared,
+                &format!("failed to write transport reset event: {err:?}"),
+            );
+            return false;
+        }
+
+        if let Err(err) = queue.add_used(
+            desc_chain.memory(),
+            desc_chain.head_index(),
+            size_of::<u32>() as u32,
+        ) {
+            self.report_publish_failure(
+                &shared,
+                &format!("failed to publish transport reset event: {err:?}"),
+            );
+            return false;
+        }
+        drop(queue);
+
+        // Record the driver's avail index before the guest can consume the
+        // used entry; the acknowledgement requires advancing it.
+        shared.expected_avail.store(baseline.into(), Ordering::Release);
+        shared.acked.store(false, Ordering::Release);
+        self.transport_reset_pending.store(true, Ordering::Release);
+        self.reset_published.store(true, Ordering::Release);
+
+        if let Err(err) = self.signal_used_queue(EVT_QUEUE_INDEX as u16) {
+            // The used entry and pending state are the contract; the guest
+            // will see them on the next notification or after resume.
+            warn!("vsock: failed to signal running transport reset event: {err:?}");
+        }
+        info!("vsock: transport reset published (running reset); waiting for guest acknowledgement");
+
+        if self.reset_hooks.stale_kick {
+            match self.queue_evts[EVT_QUEUE_INDEX].write(1) {
+                Ok(_) => info!("vsock: injected stale event queue kick (test hook)"),
+                Err(err) => warn!("vsock: failed to inject stale kick: {err:?}"),
+            }
+        }
+
+        let reported = !self.reset_hooks.fail_after_publish;
+        if !reported {
+            error!("vsock: transport reset published but reporting failure (test hook)");
+        }
+        shared.published.store(reported, Ordering::Release);
+        shared.completed.store(true, Ordering::Release);
+
+        true
+    }
